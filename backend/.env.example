# WorkProof Expo Go OAuth Bridge — 서버 전용 환경변수.
# 절대 mobile/.env 나 EXPO_PUBLIC_* 로 옮기지 말 것 — 여기 있는 값들은
# 앱 번들에 노출되면 안 되는 진짜 시크릿이다.
#
# 각 provider의 콘솔에 등록할 Redirect/Callback URI는
# {이 서버의 base URL}/auth/{provider}/callback 형식이다.
# 예) https://workproof-auth.onrender.com/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REST API 키(Client ID)와 별개인 Client Secret — 카카오 콘솔에서 사용 설정한
# 경우만 채운다. 비워두면 토큰 교환 요청에서 생략된다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 기존 mobile/.env의 EXPO_PUBLIC_NAVER_CLIENT_SECRET(앱 바이너리에 노출되던
# 값)을 대체한다. Expo Go 브리지 흐름에서는 이 서버 전용 값만 사용한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 서버를 호출할 프론트엔드 origin(CORS 허용 origin). 콤마로 여러 개
# 등록 가능. 비워두면 전체 허용(*) — 로컬 개발 편의용 기본값이니 운영에서는
# 채워 넣는 걸 권장한다.
FRONTEND_ALLOWED_ORIGIN=

# OAuth state 파라미터 서명에 쓰는 비밀값. 충분히 길고 무작위인 문자열을
# 사용할 것 (예: python -c "import secrets; print(secrets.token_urlsafe(32))").
# 비어있으면 서버가 기동하지 않는다.
SESSION_SIGNING_SECRET=
