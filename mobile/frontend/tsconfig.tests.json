{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist-tests"
  },
  "include": [
    "tests/**/*.ts",
    "src/payCalc.ts",
    "src/utils/geo.ts",
    "src/utils/appLockState.ts",
    "src/storageKeys.ts",
    "src/types.ts"
  ]
}
