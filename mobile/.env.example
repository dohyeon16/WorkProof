# Social login credentials — see OAUTH_SETUP.md for how to obtain each value.
# Copy this file to `.env` (or `.env.local`) and fill in what you have; any
# provider left blank is skipped with a "준비 중" message in the app.

EXPO_PUBLIC_GOOGLE_CLIENT_ID=

EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_CLIENT_SECRET=

EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
