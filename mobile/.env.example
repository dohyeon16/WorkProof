# Social login credentials — see OAUTH_SETUP.md for how to obtain each value.
# Copy this file to `.env` (or `.env.local`) and fill in what you have; any
# provider left blank is skipped with a "준비 중" message in the app.

EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Android development/standalone build only — a separate "Android" type
# OAuth client (package name + SHA-1, "Custom URI scheme" enabled). The
# EXPO_PUBLIC_GOOGLE_CLIENT_ID above is a "Web application" client and
# cannot be reused here — see OAUTH_SETUP.md.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS development/standalone build only — a separate "iOS" type OAuth client
# scoped to Bundle ID com.workproof.app (ios.bundleIdentifier in
# app.config.ts). Same reason as the Android client above: the "Web
# application" client only accepts http(s) redirect URIs. See OAUTH_SETUP.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_CLIENT_SECRET=
# iOS/Android 네이티브 전용 — 카카오 콘솔의 "앱 키" 중 REST API 키(위
# CLIENT_ID)와는 다른 "네이티브 앱 키". @react-native-seoul/kakao-login
# 네이티브 SDK가 이 값을 빌드타임에 app.config.ts를 통해 읽어 두 플랫폼
# 모두에 심는다(Android: AndroidManifest/strings.xml, iOS: Info.plist의
# KAKAO_APP_KEY + kakao{KEY}://oauth 스킴). 패키지명/Bundle ID
# (com.workproof.app)와 키 해시(Android) 등록도 필요 — OAUTH_SETUP.md 참고.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

EXPO_PUBLIC_NAVER_CLIENT_ID=  # 웹은 Naver Login JS SDK(Client Secret 불필요), iOS/Android 네이티브 SDK는 아래 SECRET도 필요
# iOS/Android 네이티브 전용 — @react-native-seoul/naver-login 네이티브
# SDK는 시크릿 없는 client-side 전용 토큰 발급 경로가 없어, 이 값이 앱
# 바이너리에 그대로 포함된다(디컴파일로 추출 가능). 이 프로젝트의 기존
# "시크릿을 앱에 넣지 않는다" 원칙과 어긋나는 트레이드오프를 감수하고
# 채택한 값 — 배경은 OAUTH_SETUP.md의 Naver 섹션 참고.
EXPO_PUBLIC_NAVER_CLIENT_SECRET=

# 근무지 장소 검색(카카오 로컬) — 네이티브는 위 KAKAO_CLIENT_ID(REST API 키)를
# 그대로 재사용하고, 웹은 카카오 로컬 REST API가 브라우저 CORS를 지원하지
# 않아 카카오맵 JavaScript SDK용 별도 키가 필요하다. 자세한 내용은
# OAUTH_SETUP.md 참고.
EXPO_PUBLIC_KAKAO_JS_KEY=

# 근로계약서 사본 OCR(Google Cloud Vision) — 이미지/PDF에서 글자를 추출한다.
# 비워두면 첨부는 되지만 텍스트 추출은 "준비 중"으로 안내된다. OAUTH_SETUP.md 참고.
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# 근로계약서 OCR 텍스트 AI 요약(Google Gemini, 무료 티어) — Google AI Studio에서
# 발급. 비워두면 OCR 텍스트 추출까지는 되지만 요약은 "준비 중"으로 안내된다.
# OAUTH_SETUP.md 참고.
EXPO_PUBLIC_GEMINI_API_KEY=

# Expo Go 전용 소셜 로그인 브리지(backend/) 주소. Expo Go는 커스텀 URL
# 스킴(workproof://)과 Kakao/Naver 네이티브 SDK를 쓸 수 없어서, Expo Go에서
# 소셜 로그인 버튼을 누르면 이 값(EXPO_PUBLIC_AUTH_API_URL)이 가리키는
# FastAPI 서버가 대신 OAuth 코드 교환을 처리한다(src/auth/expoGoOAuth.ts).
# web과 Android/iOS Development Build는 이 값을 쓰지 않는다 — 기존 방식 그대로
# 동작한다. 값과 배포 방법은 backend/README.md, 등록 절차는 아래 "Expo Go 전용
# 소셜 로그인" 섹션 참고.
EXPO_PUBLIC_AUTH_API_URL=

# Phase 2.5 이메일 인증 백엔드(FastAPI /api/v1/auth·/users) 기본 주소. 비밀 아님(공개 설정).
# 미지정 시 개발/Preview 기본값(아래 Preview)으로 폴백한다. 운영 빌드는 Production 주소를 지정한다.
#   - 개발/Preview: https://workproof-backend-preview.onrender.com
#   - Production:   https://workproof-auth.onrender.com
# 이 값은 위 EXPO_PUBLIC_AUTH_API_URL(Expo Go OAuth 브릿지)과 별개다 — 접두사(/api/v1)는 앱이 붙인다.
EXPO_PUBLIC_API_BASE_URL=
