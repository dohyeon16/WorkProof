# WorkProof Expo Go OAuth Bridge — 서버 전용 환경변수.
# 절대 mobile/.env 나 EXPO_PUBLIC_* 로 옮기지 말 것 — 여기 있는 값들은
# 앱 번들에 노출되면 안 되는 진짜 시크릿이다.
#
# 각 provider의 콘솔에 등록할 Redirect/Callback URI는
# {이 서버의 base URL}/auth/{provider}/callback 형식이다.
# 예) https://workproof-auth.onrender.com/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REST API 키(Client ID)와 별개인 Client Secret — 카카오 콘솔에서 사용 설정한
# 경우만 채운다. 비워두면 토큰 교환 요청에서 생략된다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 기존 mobile/.env의 EXPO_PUBLIC_NAVER_CLIENT_SECRET(앱 바이너리에 노출되던
# 값)을 대체한다. Expo Go 브리지 흐름에서는 이 서버 전용 값만 사용한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 서버를 호출할 프론트엔드 origin(CORS 허용 origin). 콤마로 여러 개
# 등록 가능. 비워두면 전체 허용(*) — 로컬 개발 편의용 기본값이니 운영에서는
# 채워 넣는 걸 권장한다.
FRONTEND_ALLOWED_ORIGIN=

# OAuth state 파라미터 서명에 쓰는 비밀값. 충분히 길고 무작위인 문자열을
# 사용할 것 (예: python -c "import secrets; print(secrets.token_urlsafe(32))").
# 비어있으면 서버가 기동하지 않는다.
SESSION_SIGNING_SECRET=

# --- Phase 1: 데이터 API / DB 기반 ---
# PostgreSQL 접속 URL. 예: postgresql+psycopg://USER:PASSWORD@HOST:5432/workproof
# 비워두면 DB 기능이 비활성화되고(/api/v1/health/db 가 unavailable 반환),
# import 만으로는 DB에 접속하지 않는다. 실제 값/시크릿은 여기 두지 말 것.
DATABASE_URL=
# 실행 환경: development | production
ENVIRONMENT=development
# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Phase 2: 인증(JWT) ---
# access JWT(HS256) 서명 키. SESSION_SIGNING_SECRET 과 반드시 분리된 별도 값을
# 쓸 것. 충분히 길고 무작위인 문자열
# (예: python -c "import secrets; print(secrets.token_urlsafe(48))").
# 비어 있으면 앱은 기동하되 토큰 발급/검증 시점에 실패한다. 실제 값은 여기 두지 말 것.
JWT_SECRET_KEY=
# access token 만료(분). 기본 15.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# refresh token 만료(일). 기본 30.
REFRESH_TOKEN_EXPIRE_DAYS=30
# 서버가 provider credential을 검증하지 못하는 직접 소셜 로그인을 허용할지.
# false(기본) 권장 — true 로 두면 클라이언트가 보낸 provider_user_id를 그대로
# 신뢰해 위조가 가능하므로 운영에서는 절대 켜지 말 것.
ALLOW_UNVERIFIED_SOCIAL=false

# --- Phase 4C: AI 프록시 (서버 보관 · 클라이언트에 절대 노출 금지) ---
# Google Cloud Vision / Gemini API 키. 기존에는 모바일이 EXPO_PUBLIC_* 로 직접
# 호출해 키가 앱 번들에 노출됐다. 이제 서버가 대신 호출하므로 키는 여기(서버 env)
# 에만 둔다. 비어 있으면 /api/v1/ai/* 는 503(미설정)을 돌려준다. 실제 값은 여기 두지 말 것.
GOOGLE_VISION_API_KEY=
GEMINI_API_KEY=
# Gemini 모델명(기본 gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash
